# Copy to .env and adjust. Environment variables override config.yaml.

# Folder scanned by 'extract' (no args) and 'watch'
INVOICE_INPUT_DIR=samples
# Where invoices.xlsx / invoices.json are written
INVOICE_OUTPUT_DIR=output
# Max rounding difference tolerated by validation checks
INVOICE_TOLERANCE=0.01
# Seconds between watch-folder scans
INVOICE_WATCH_INTERVAL=5
# Optional OCR fallback for scanned PDFs (requires pytesseract + Tesseract)
INVOICE_OCR_ENABLED=false
INVOICE_OCR_LANGUAGE=eng
# Alternative config file location
# INVOICE_CONFIG=config.yaml
LOG_LEVEL=INFO
